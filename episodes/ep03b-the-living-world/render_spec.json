 "captions": [
  {
   "start": 0.5,
   "end": 1.5,
   "text": "And God said,"
  },
  {
   "start": 2.33,
   "end": 5.96,
   "text": "Let the waters bring forth / abundantly the moving creature / that hath life,"
  },
  {
   "start": 6.31,
   "end": 9.89,
   "text": "and fowl that may fly / above the earth in the open / firmament of heaven."
  },
  {
   "start": 13.0,
   "end": 15.5,
   "text": "And God created great whales,"
  },
  {
   "start": 16.3,
   "end": 18.5,
   "text": "and every living creature / that moveth,"
  },
  {
   "start": 18.97,
   "end": 21.16,
   "text": "which the waters brought forth / abundantly,"
  },
  {
   "start": 21.86,
   "end": 22.98,
   "text": "after their kind,"
  },
  {
   "start": 23.8,
   "end": 26.27,
   "text": "and every winged fowl / after his kind:"
  },
  {
   "start": 26.89,
   "end": 28.7,
   "text": "and God saw that it was good."
  },
  {
   "start": 31.8,
   "end": 34.0,
   "text": "And God blessed them, saying,"
  },
  {
   "start": 34.7,
   "end": 36.61,
   "text": "Be fruitful, and multiply,"
  },
  {
   "start": 36.99,
   "end": 38.56,
   "text": "and fill the waters in the seas,"
  },
  {
   "start": 38.93,
   "end": 40.78,
   "text": "and let fowl multiply / in the earth."
  },
  {
   "start": 45.0,
   "end": 48.3,
   "text": "And the evening and the morning / were the fifth day."
  },
  {
   "start": 53.0,
   "end": 54.0,
   "text": "And God said,"
  },
  {
   "start": 54.87,
   "end": 57.95,
   "text": "Let the earth bring forth / the living creature"
  },
  {
   "start": 58.22,
   "end": 59.82,
   "text": "after his kind, / cattle, and creeping thing,"
  },
  {
   "start": 60.21,
   "end": 62.09,
   "text": "and beast of the earth / after his kind:"
  },
  {
   "start": 62.8,
   "end": 63.8,
   "text": "and it was so."
  }
 ],
