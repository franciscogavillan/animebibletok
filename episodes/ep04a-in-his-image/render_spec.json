 "captions": [
  {
   "start": 0.5,
   "end": 1.5,
   "text": "And God said,"
  },
  {
   "start": 2.37,
   "end": 3.93,
   "text": "Let us make man in our image,"
  },
  {
   "start": 4.16,
   "end": 5.16,
   "text": "after our likeness:"
  },
  {
   "start": 5.74,
   "end": 8.05,
   "text": "and let them have dominion / over the fish of the sea,"
  },
  {
   "start": 8.55,
   "end": 9.85,
   "text": "and over the fowl of the air,"
  },
  {
   "start": 10.37,
   "end": 11.21,
   "text": "and over the cattle,"
  },
  {
   "start": 11.72,
   "end": 12.83,
   "text": "and over all the earth,"
  },
  {
   "start": 13.39,
   "end": 16.45,
   "text": "and over every creeping thing / that creepeth upon the earth."
  },
  {
   "start": 19.0,
   "end": 22.3,
   "text": "So God created man / in his own image,"
  },
  {
   "start": 23.0,
   "end": 26.2,
   "text": "in the image of God / created he him;"
  },
  {
   "start": 27.0,
   "end": 30.4,
   "text": "male and female / created he them."
  },
  {
   "start": 33.0,
   "end": 35.9,
   "text": "And God blessed them, / and God said unto them,"
  },
  {
   "start": 36.67,
   "end": 39.35,
   "text": "Be fruitful, and multiply, / and replenish the earth,"
  },
  {
   "start": 39.65,
   "end": 40.41,
   "text": "and subdue it:"
  },
  {
   "start": 40.88,
   "end": 42.68,
   "text": "and have dominion / over the fish of the sea,"
  },
  {
   "start": 43.07,
   "end": 44.32,
   "text": "and over the fowl of the air,"
  },
  {
   "start": 44.75,
   "end": 47.22,
   "text": "and over every living thing / that moveth upon the earth."
  }
 ],
