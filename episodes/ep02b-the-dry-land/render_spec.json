  "captions": [
    {"start": 0.5,  "end": 1.5,  "text": "And God said,"},
    {"start": 1.9,  "end": 4.95, "text": "Let the waters under the heaven / be gathered together"},
    {"start": 5.0,  "end": 6.9,  "text": "unto one place, / and let the dry land appear:"},
    {"start": 11.8, "end": 12.8, "text": "and it was so."},
    {"start": 16.3, "end": 18.9, "text": "And God called / the dry land Earth;"},
    {"start": 19.5, "end": 23.4, "text": "and the gathering together / of the waters called he Seas:"},
    {"start": 23.95, "end": 26.6, "text": "and God saw that it was good."},
    {"start": 30.5, "end": 31.5, "text": "And God said,"},
    {"start": 31.85, "end": 35.5, "text": "Let the earth bring forth grass, / the herb yielding seed,"},
    {"start": 35.85, "end": 38.6, "text": "and the fruit tree yielding fruit / after his kind,"},
    {"start": 38.75, "end": 41.3, "text": "whose seed is in itself, / upon the earth:"},
    {"start": 42.0, "end": 43.0, "text": "and it was so."},
    {"start": 45.3, "end": 48.9, "text": "And the earth brought forth grass, / and herb yielding seed"},
    {"start": 49.0, "end": 50.6, "text": "after his kind,"},
    {"start": 51.05, "end": 54.55, "text": "and the tree yielding fruit, / whose seed was in itself,"},
    {"start": 54.9, "end": 56.1, "text": "after his kind:"},
    {"start": 56.75, "end": 59.0, "text": "and God saw that it was good."},
    {"start": 63.0, "end": 66.9, "text": "And the evening and the morning / were the third day."}
  ],
