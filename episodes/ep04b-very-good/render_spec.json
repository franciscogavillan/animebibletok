 "captions": [
  {
   "start": 3.0,
   "end": 4.0,
   "text": "And God said,"
  },
  {
   "start": 4.8,
   "end": 7.76,
   "text": "Behold, I have given you / every herb bearing seed,"
  },
  {
   "start": 8.18,
   "end": 9.86,
   "text": "which is upon the face / of all the earth,"
  },
  {
   "start": 10.27,
   "end": 13.76,
   "text": "and every tree, in the which / is the fruit of a tree yielding seed;"
  },
  {
   "start": 14.36,
   "end": 15.67,
   "text": "to you it shall be for meat."
  },
  {
   "start": 16.84,
   "end": 18.22,
   "text": "And to every beast of the earth,"
  },
  {
   "start": 18.54,
   "end": 19.99,
   "text": "and to every fowl of the air,"
  },
  {
   "start": 20.41,
   "end": 22.38,
   "text": "and to every thing / that creepeth upon the earth,"
  },
  {
   "start": 22.81,
   "end": 23.84,
   "text": "wherein there is life,"
  },
  {
   "start": 24.39,
   "end": 26.63,
   "text": "I have given every green herb / for meat:"
  },
  {
   "start": 27.4,
   "end": 28.4,
   "text": "and it was so."
  },
  {
   "start": 31.0,
   "end": 33.28,
   "text": "And God saw every thing / that he had made,"
  },
  {
   "start": 33.88,
   "end": 36.33,
   "text": "and, behold, it was very good."
  },
  {
   "start": 48.0,
   "end": 51.3,
   "text": "And the evening and the morning / were the sixth day."
  }
 ],
