 "captions": [
  {
   "start": 0.5,
   "end": 1.5,
   "text": "And God said,"
  },
  {
   "start": 2.48,
   "end": 4.77,
   "text": "Let there be lights / in the firmament of the heaven"
  },
  {
   "start": 5.26,
   "end": 6.9,
   "text": "to divide the day / from the night;"
  },
  {
   "start": 7.58,
   "end": 10.41,
   "text": "and let them be for signs, / and for seasons,"
  },
  {
   "start": 10.75,
   "end": 12.59,
   "text": "and for days, and years:"
  },
  {
   "start": 13.65,
   "end": 16.27,
   "text": "And let them be for lights / in the firmament of the heaven"
  },
  {
   "start": 16.55,
   "end": 17.91,
   "text": "to give light upon the earth:"
  },
  {
   "start": 19.4,
   "end": 20.4,
   "text": "and it was so."
  },
  {
   "start": 23.6,
   "end": 25.7,
   "text": "And God made two great lights;"
  },
  {
   "start": 26.9,
   "end": 29.3,
   "text": "the greater light / to rule the day,"
  },
  {
   "start": 36.1,
   "end": 38.5,
   "text": "and the lesser light / to rule the night:"
  },
  {
   "start": 46.1,
   "end": 47.9,
   "text": "he made the stars also."
  },
  {
   "start": 58.1,
   "end": 61.2,
   "text": "And the evening and the morning / were the fourth day."
  }
 ],
